{
  "name": "roast-menu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ROAST Hamburguesas Artesanales — carta digital para código QR",
  "scripts": {
    "dev": "next dev -p 3520",
    "build": "node scripts/verificar-config.mjs && node scripts/generar-qr.mjs --al-compilar && next build",
    "start": "node scripts/servir.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "python tests/e2e/test_menu.py",
    "imagenes": "python scripts/procesar-imagenes.py",
    "qr": "node scripts/generar-qr.mjs"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.10.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
