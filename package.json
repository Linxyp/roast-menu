{
  "name": "roast-menu",
  "version": "2.0.0",
  "private": true,
  "description": "ROAST Hamburguesas Artesanales — carta con pedidos por QR desde la mesa, panel de pedidos con recibo para cocina y administración",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3520",
    "build": "next build",
    "start": "next start -p 3520",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integracion": "vitest run --config vitest.integracion.mts",
    "test:e2e": "python tests/e2e/test_sistema.py",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:migrar": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "imagenes": "python scripts/procesar-imagenes.py",
    "desplegar": "bash scripts/desplegar-servidor.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.5",
    "next": "16.3.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.10.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "lightningcss": "1.32.0",
    "unrs-resolver": "1.12.2",
    "vite": "8.3.2",
    "rolldown": "1.2.12"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  },
  "browserslist": [
    "chrome >= 87",
    "edge >= 87",
    "firefox >= 78",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "samsung >= 14"
  ]
}
