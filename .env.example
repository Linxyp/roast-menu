# Copiar a .env para desarrollo local (npm run db:up && npm run db:migrar && npm run db:seed && npm run dev)

# Base de datos (docker-compose.yml la publica en 127.0.0.1:5547)
POSTGRES_PASSWORD=cambia-esta-clave
DATABASE_URL=postgresql://roast:cambia-esta-clave@127.0.0.1:5547/roast
DATABASE_URL_TEST=postgresql://roast:cambia-esta-clave@127.0.0.1:5547/roast_test

# Dirección pública del sistema (con ella se generan los QR de las mesas)
APP_URL=http://localhost:3520

# Secreto de las sesiones del panel: 48+ caracteres aleatorios
AUTH_SECRET=

# Primer usuario administrador (lo crea `npm run db:seed` si no existe)
SEED_ADMIN_USUARIO=admin
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_CLAVE=
